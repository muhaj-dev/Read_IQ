# HydraDB Cloud — https://dashboard.hydradb.com
# Copy to .env and fill in. `.env` is gitignored; never commit real keys.
# EXPO_PUBLIC_ prefix is required for Expo to expose values to the app bundle.

EXPO_PUBLIC_HYDRA_API_KEY=
EXPO_PUBLIC_HYDRA_BASE_URL=https://api.hydradb.com
EXPO_PUBLIC_HYDRA_DATABASE=readiq
EXPO_PUBLIC_HYDRA_COLLECTION=readiq

# Groq — https://console.groq.com/keys
# Used for two things: writing quiz questions from your notes, and transcribing
# recordings (Whisper). HydraDB does all retrieval, root-cause and memory work
# and never touches Groq.
# Leave blank and the app still runs: Quiz goes dark and Record falls back to a
# manual, editable transcript.

EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
